# Renawi Motors - environment variables.
# Copy to .env (cp .env.example .env). The defaults below work with `docker compose up -d postgres`.
# Never commit a real .env; production secrets live only on the server.

# --- Database -------------------------------------------------------------------------------
# Host port of the docker-compose "postgres" service (change, with the URLs below, if 5432 is taken).
POSTGRES_PORT=5432
# Main PostgreSQL database (docker-compose.yml service "postgres").
DATABASE_URL=postgresql://renawi:renawi@localhost:5432/renawi?schema=public
# Separate database used by the API e2e tests (created by deploy/db/init-test-db.sql).
TEST_DATABASE_URL=postgresql://renawi:renawi@localhost:5432/renawi_test?schema=public

# --- Auth -----------------------------------------------------------------------------------
# Secrets for signing the access / refresh JWTs. Use long random values (>= 32 chars) that differ
# from each other, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# Token lifetimes (ms-style durations: 15m, 12h, 30d).
ACCESS_TTL=15m
REFRESH_TTL=30d
# Set to true behind HTTPS (production) so the auth cookies get the Secure flag.
COOKIE_SECURE=false
# Origin allowed by CORS (the Vite dev server in development); comma-separate several origins.
CORS_ORIGIN=http://localhost:5173
# Login attempts allowed per IP per minute (optional, default 10).
# LOGIN_THROTTLE_LIMIT=10

# --- Files ----------------------------------------------------------------------------------
# Where uploaded documents and photos are stored (relative to the API working directory, i.e.
# apps/api/data/uploads in development). Keys are yyyy/mm/<uuid>.<ext>; images get a
# <key>.thumb.webp thumbnail next to them. The seed writes its placeholder files here too.
UPLOAD_DIR=./data/uploads
# Maximum upload size in megabytes (larger files are rejected with 413 errors.fileTooLarge).
MAX_UPLOAD_MB=20
# Status file of the nightly backup, read by GET /api/settings/backup-status (relative to the API
# working directory). The backup sidecar (milestone 7) writes {"lastSuccessAt": "<ISO>",
# "lastFile": "<name>"} after every successful run; a missing file reports ok: false.
BACKUP_STATUS_FILE=./data/backup/last-success.json

# --- Server ---------------------------------------------------------------------------------
# API HTTP port.
PORT=3000
# Process time zone. Keep UTC; calendar dates travel as YYYY-MM-DD strings.
TZ=UTC
# Business time zone used for "today", rent billing runs and cron jobs.
BUSINESS_TZ=Asia/Jerusalem
# Set to false to disable the scheduled jobs (optional, default true; the e2e tests turn them off).
# CRON_ENABLED=true
# Express "trust proxy" behind a reverse proxy, e.g. 1 or loopback (optional; production only).
# TRUST_PROXY=1

# --- Seed -----------------------------------------------------------------------------------
# Initial admin user created by `npm run db:seed` (change the password after the first login).
ADMIN_EMAIL=admin@renawi.local
ADMIN_PASSWORD=ChangeMe123!
# Display name of that admin user (optional, default "Elias Renawi").
# ADMIN_NAME=Elias Renawi
# Set to false to seed only the admin user and settings, without the demo data and its
# placeholder documents (use false in production).
# SEED_DEMO=true

# --- Web (Vite) -----------------------------------------------------------------------------
# Target of the Vite dev-server proxy for /api requests.
VITE_API_PROXY=http://localhost:3000
