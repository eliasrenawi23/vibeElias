# Renawi Motors - PRODUCTION environment (server: /opt/renawi/.env, mode 600, owner deploy).
#   cp .env.production.example .env && chmod 600 .env && nano .env
# Replace every CHANGE_ME. Never commit the real file; it holds every secret of the system.
# Keep a copy in a password manager (it is not part of the nightly backup).
#
# Syntax: KEY=value, no spaces around "=". Docker Compose expands $NAME inside values, so wrap a
# value that contains "$" in single quotes, e.g. ADMIN_PASSWORD='pa$$word1'.
# Step by step: docs/ops/deploy.md

# --- Compose ---------------------------------------------------------------------------------
# Lets plain `docker compose ...` in /opt/renawi use the production file. To build the images on
# the server instead of pulling them: docker-compose.prod.yml:docker-compose.build.yml
COMPOSE_FILE=docker-compose.prod.yml
# Where the images come from: ghcr.io/<GitHub user or organisation, lowercase>.
IMAGE_PREFIX=ghcr.io/CHANGE_ME
# Image tag: latest, or a commit tag such as sha-1a2b3c4 to pin / roll back
# (deploy/deploy.sh <tag> updates this line for you).
IMAGE_TAG=latest

# --- Domain and HTTPS ----------------------------------------------------------------------------
# Public host name; its DNS A record must point at the server. Before you have a domain, use
# the server IP with dashes + .sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=CHANGE_ME.example.co.il
# Let's Encrypt account e-mail (certificate expiry warnings).
ACME_EMAIL=CHANGE_ME@example.com

# --- Database ------------------------------------------------------------------------------------
POSTGRES_USER=renawi
POSTGRES_DB=renawi
# URL-safe random password: openssl rand -hex 32
# Used only when the database volume is first created (changing it later: docs/ops/security.md).
POSTGRES_PASSWORD=CHANGE_ME
# The API connects to the compose service "postgres". Built automatically from the three values
# above; set it only to override (the password must then match POSTGRES_PASSWORD).
# DATABASE_URL=postgresql://renawi:<POSTGRES_PASSWORD>@postgres:5432/renawi?schema=public

# --- Auth ----------------------------------------------------------------------------------------
# Two different long random secrets, each generated with: openssl rand -base64 48
# Changing them signs everybody out (rotation: docs/ops/security.md).
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
ACCESS_TTL=15m
REFRESH_TTL=30d
# HTTPS only: the auth cookies get the Secure flag.
COOKIE_SECURE=true
# Origin of the web app (Compose fills in DOMAIN from above).
CORS_ORIGIN=https://${DOMAIN}
# Proxies whose X-Forwarded-For is trusted: Caddy and nginx on the private Docker networks.
# (Not "true": Express rejects that value and the API would not start.)
TRUST_PROXY=loopback,uniquelocal
# Login attempts allowed per IP address per minute.
LOGIN_THROTTLE_LIMIT=10

# --- First admin user ------------------------------------------------------------------------------
# Created once with `docker compose run --rm admin`. Later changes here do not change the user;
# `docker compose run --rm admin node create-admin.cjs --reset-password` sets this password again.
# Password: 8-128 characters with letters and digits; use 16+ random characters.
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Elias Renawi
# Production never gets the demo data (only `npm run db:seed` in development reads this).
SEED_DEMO=false

# --- Time ------------------------------------------------------------------------------------------
# The API process runs in UTC; "today", nightly rent billing and reminders use BUSINESS_TZ.
TZ=UTC
BUSINESS_TZ=Asia/Jerusalem
# Scheduled jobs (nightly rent billing). Keep true in production.
CRON_ENABLED=true

# --- Files and PDFs ----------------------------------------------------------------------------------
# Largest upload in MB (nginx accepts up to 25 MB per request).
MAX_UPLOAD_MB=20
# PDF renders running at the same time in the API's Chromium (1 suits a 4 GB server).
PDF_CONCURRENCY=1
# Upper limit of one PDF render in milliseconds.
PDF_TIMEOUT_MS=60000

# --- Backups -------------------------------------------------------------------------------------------
# Nightly at 02:30 in BACKUP_TZ: database dump + uploads archive. With S3_BUCKET empty the
# backups stay on this server only (the log says so) - set up the bucket (docs/ops/deploy.md).
# S3-compatible storage; Backblaze B2 example (endpoint and region from the bucket's page):
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
# B2 application key restricted to the bucket: keyID / applicationKey.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Folder inside the bucket.
S3_PREFIX=renawi/
# Days to keep backups in the bucket, and number of nightly backups kept on the server.
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_KEEP=7
# Cron schedule (5 fields) and its time zone; empty BACKUP_CRON = 30 2 * * * (02:30).
BACKUP_CRON=
BACKUP_TZ=Asia/Jerusalem
# Host folder for the local copies (relative to /opt/renawi).
BACKUP_LOCAL_DIR=./backups
# Optional dead-man switch, e.g. https://hc-ping.com/<uuid> (healthchecks.io): pinged on start,
# success and /fail; it e-mails you when a night is missed or fails.
HEALTHCHECK_PING_URL=
