{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS runs as CommonJS (decorator metadata, Nest CLI); @renawi/shared ships a CJS build.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Decorated constructor/handler signatures reference classes imported as values.
    "isolatedModules": false,
    "strictPropertyInitialization": false,
    "declaration": false,
    "removeComments": false,
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "prisma"],
  "exclude": ["node_modules", "dist"]
}
