{
  "rootDir": "..",
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ],
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": [
    "<rootDir>/test/setup-env.ts"
  ],
  "testTimeout": 30000,
  "setupFilesAfterEnv": [
    "<rootDir>/test/cleanup-uploads.ts"
  ]
}
